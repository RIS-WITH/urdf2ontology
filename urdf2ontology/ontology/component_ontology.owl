<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/component_ontology#"
     xml:base="http://example.org/component_ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/component_ontology"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/component_ontology#hasComponent -->

    <owl:ObjectProperty rdf:about="http://example.org/component_ontology#hasComponent"/>
    


    <!-- http://example.org/component_ontology#hasInitialSegment -->

    <owl:ObjectProperty rdf:about="http://example.org/component_ontology#hasInitialSegment">
        <rdfs:subPropertyOf rdf:resource="http://example.org/component_ontology#hasSegment"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/component_ontology#hasNextSegment -->

    <owl:ObjectProperty rdf:about="http://example.org/component_ontology#hasNextSegment">
        <rdfs:subPropertyOf rdf:resource="http://example.org/component_ontology#hasSegment"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/component_ontology#hasOrphanNode -->

    <owl:ObjectProperty rdf:about="http://example.org/component_ontology#hasOrphanNode">
        <rdfs:subPropertyOf rdf:resource="http://example.org/component_ontology#hasComponent"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/component_ontology#hasSegment -->

    <owl:ObjectProperty rdf:about="http://example.org/component_ontology#hasSegment">
        <rdfs:subPropertyOf rdf:resource="http://example.org/component_ontology#hasComponent"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/component_ontology#hasSubPart -->

    <owl:ObjectProperty rdf:about="http://example.org/component_ontology#hasSubPart">
        <rdfs:subPropertyOf rdf:resource="http://example.org/component_ontology#hasComponent"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/component_ontology#hasSubSystem -->

    <owl:ObjectProperty rdf:about="http://example.org/component_ontology#hasSubSystem">
        <rdfs:subPropertyOf rdf:resource="http://example.org/component_ontology#hasComponent"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/component_ontology#hasTerminalSegment -->

    <owl:ObjectProperty rdf:about="http://example.org/component_ontology#hasTerminalSegment">
        <rdfs:subPropertyOf rdf:resource="http://example.org/component_ontology#hasSegment"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/robotics#hasBodyPartSubpart -->

    <owl:ObjectProperty rdf:about="http://example.org/robotics#hasBodyPartSubpart">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/ieee1872-owl/cora#part"/>
        <rdfs:domain rdf:resource="http://example.org/robotics#BodyPart"/>
        <rdfs:range rdf:resource="http://example.org/robotics#BodyPartSubpart"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/robotics#hasEndEffectorSubpart -->

    <owl:ObjectProperty rdf:about="http://example.org/robotics#hasEndEffectorSubpart">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/ieee1872-owl/cora#part"/>
        <rdfs:domain rdf:resource="http://example.org/robotics#EndEffector"/>
        <rdfs:range rdf:resource="http://example.org/robotics#EndEffectorSubpart"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/robotics#hasLocomotionSubpart -->

    <owl:ObjectProperty rdf:about="http://example.org/robotics#hasLocomotionSubpart">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/ieee1872-owl/cora#part"/>
        <rdfs:domain rdf:resource="http://example.org/robotics#Locomotion"/>
        <rdfs:range rdf:resource="http://example.org/robotics#LocomotionSubpart"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/robotics#hasSensorSubpart -->

    <owl:ObjectProperty rdf:about="http://example.org/robotics#hasSensorSubpart">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/ieee1872-owl/cora#part"/>
        <rdfs:domain rdf:resource="http://example.org/robotics#Robot"/>
        <rdfs:range rdf:resource="http://example.org/robotics#SensingDeviceSubpart"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ieee1872-owl/cora#part -->

    <owl:ObjectProperty rdf:about="http://purl.org/ieee1872-owl/cora#part"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/component_ontology#hasAssemblyLinkFrame -->

    <owl:DatatypeProperty rdf:about="http://example.org/component_ontology#hasAssemblyLinkFrame">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/component_ontology#hasLinkFrame -->

    <owl:DatatypeProperty rdf:about="http://example.org/component_ontology#hasLinkFrame">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/component_ontology#mountsOn -->

    <owl:DatatypeProperty rdf:about="http://example.org/component_ontology#mountsOn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    
    <owl:Class rdf:about="http://example.org/robotics#RotorAssembly">
        <rdfs:subClassOf rdf:resource="http://example.org/robotics#PropulsionSubpart"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/robotics#Propeller">
        <rdfs:subClassOf rdf:resource="http://example.org/robotics#PropulsionSubpart"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/robotics#RotorBlade">
        <rdfs:subClassOf rdf:resource="http://example.org/robotics#PropulsionSubpart"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/robotics#LandingGear">
        <rdfs:subClassOf rdf:resource="http://example.org/robotics#LocomotionSubpart"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/robotics#LandingLeg">
        <rdfs:subClassOf rdf:resource="http://example.org/robotics#LandingGear"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/robotics#LandingSkid">
        <rdfs:subClassOf rdf:resource="http://example.org/robotics#LandingGear"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/robotics#RotorArm">
        <rdfs:subClassOf rdf:resource="http://example.org/robotics#StructuralBaseSubpart"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/robotics#GimbaMount">
        <rdfs:subClassOf rdf:resource="http://example.org/robotics#StructuralConnectorSubpart"/>
    </owl:Class>


    <!-- http://example.org/component_ontology#AcousticSensorSubpart -->

    <owl:Class rdf:about="http://example.org/component_ontology#AcousticSensorSubpart">
        <rdfs:subClassOf rdf:resource="http://example.org/robotics#SensorSubpart"/>
    </owl:Class>
    


    <!-- http://example.org/component_ontology#Ankle -->

    <owl:Class rdf:about="http://example.org/component_ontology#Ankle">
        <rdfs:subClassOf rdf:resource="http://example.org/component_ontology#LegSubpart"/>
    </owl:Class>
    


    <!-- http://example.org/component_ontology#ArmSubpart -->

    <owl:Class rdf:about="http://example.org/component_ontology#ArmSubpart">
        <rdfs:subClassOf rdf:resource="http://example.org/robotics#BodyPartSubpart"/>
    </owl:Class>
    


    <!-- http://example.org/component_ontology#BumperSensor -->

    <owl:Class rdf:about="http://example.org/component_ontology#BumperSensor">
        <rdfs:subClassOf rdf:resource="http://example.org/robotics#ContactAndTactileSensor"/>
    </owl:Class>
    


